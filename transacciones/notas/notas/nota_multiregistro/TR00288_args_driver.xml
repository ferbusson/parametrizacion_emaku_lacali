<container>
    <!--  
        Este modelo es para logica de negocios de un documento.
    -->
    <!--
        El primer paquete de subargumentos contiene informacion especifica
        para crear un documento. 
    -->
    <subarg>
        <arg attribute="consecutive" />
        <arg attribute="actionDocument">createDocument</arg>
        <arg attribute="cash" />
    </subarg>
    
    <!--  Se inserta el concepto del documento -->
    <arg>INS0037</arg>
    <arg>UPD0025</arg>    
   <!--  dcredito -->
   <arg attribute="addKey"/>
    <subarg>

    <!-- Agregando Informacion contable -->    
      <LNData>
          <driver>LNContabilidad</driver>
          <method>rowDataAccountSC</method>
      </LNData>

      <!-- Inserta valor base retenciones -->
      <LNData>
          <driver>LNSelectedField</driver>
          <method>getSubpackage</method>
          <parameters>
              <arg attribute="sql">LCINS0198</arg>
              <arg attribute="fields">11,14,13,5,8,9</arg>
              <arg attribute="conditional">"n".equals("true")  &amp;&amp; o&gt;0</arg>
          </parameters>
      </LNData>

      <!--  M O V I M I E N T O S  C U E N T A S  1 3  ( C A R T E R A  )-->
      
      <!-- 
        El siguiente paquete valida si la cuenta es de cartera,
        de terceros y esta debitada, y no tiene relacion a documento 
        para cargar el valor del debito, si es asi entonces almacenara 
        información en la tabla cartera con un nuevo documento.
       -->
    <LNData>
          <driver>LNSelectedField</driver>
          <method>getSubpackage</method>
          <parameters>
              <arg attribute="sql">DGINS0022</arg>
              <arg attribute="fields">5,8,8,11</arg>
              <arg attribute="conditional">"k".equals("true") &amp;&amp; "m".equals("true")  &amp;&amp; "e".startsWith("1")   &amp;&amp; "h".equals("NULL") &amp;&amp; i&gt;0 &amp;&amp; j==0</arg>
          </parameters>
      </LNData>
    <!--  Inserta Cartera negativa -->
    <LNData>
          <driver>LNSelectedField</driver>
          <method>getSubpackage</method>
          <parameters>
              <arg attribute="sql">LCSEL0868</arg>
              <arg attribute="fields">5,9,9,11</arg>
              <arg attribute="conditional">"k".equals("true") &amp;&amp; "m".equals("true")  &amp;&amp; "e".startsWith("1")   &amp;&amp; "h".equals("NULL") &amp;&amp; j&gt;0 &amp;&amp; i==0</arg>
          </parameters>
      </LNData>
      <!-- 
        El siguiente paquete valida si la cuenta es de cartera, 
        de terceros y esta debitada, y SI tiene relacion a documento 
        para cargar el valor del debito, si es asi entonces almacenara 
        información en la tabla cartera al documento existente.
       -->
    <LNData>
          <driver>LNSelectedField</driver>
          <method>getSubpackage</method>
          <parameters>
              <arg attribute="sql">HCINS0019</arg>
              <arg attribute="fields">5,7,8,11</arg>
              <arg attribute="conditional">"k".equals("true") &amp;&amp; "m".equals("true")  &amp;&amp; "e".startsWith("1") &amp;&amp; !"h".equals("NULL") &amp;&amp; i&gt;0 &amp;&amp; j==0</arg>
          </parameters>
      </LNData>
      
       <!-- 
        El siguiente paquete valida si la cuenta es de cartera,
        de terceros y ademas es acreditada, si es asi entonces 
        almacenara información en la tabla cartera acreditando el 
        documento recibido.
       -->
       
    <LNData>
          <driver>LNSelectedField</driver>
          <method>getSubpackage</method>
          <parameters>
              <arg attribute="sql">HCINS0018</arg>
              <arg attribute="fields">5,7,9,11</arg>
              <arg attribute="conditional">"k".equals("true") &amp;&amp; "m".equals("true") &amp;&amp; "e".startsWith("1") &amp;&amp; j&gt;0 &amp;&amp; i==0</arg>
          </parameters>
      </LNData>
      
      <!--  M O V I M I E N T O S  C U E N T A S  2  ( C U E N T A S  X  P A G A R ) -->
      
      <!-- 
        El siguiente paquete valida si la cuenta es por pagar, de
        tercero; y esta es acreditada, y no tiene relacion a documento 
        para cargar el valor del credito, si es asi entonces almacenara 
        información en la tabla cartera con un nuevo documento.
       -->
       
    <LNData>
          <driver>LNSelectedField</driver>
          <method>getSubpackage</method>
          <parameters>
              <arg attribute="sql">DGINS0022</arg>
              <arg attribute="fields">5,9,9,11</arg>
              <arg attribute="conditional">"k".equals("true") &amp;&amp; "m".equals("true")  &amp;&amp; "e".startsWith("2") &amp;&amp; "h".equals("NULL") &amp;&amp; i==0 &amp;&amp; j&gt;0</arg>
          </parameters>
      </LNData>
      
    <!--  Inserta Cartera negativa -->
    <LNData>
          <driver>LNSelectedField</driver>
          <method>getSubpackage</method>
          <parameters>
              <arg attribute="sql">LCSEL0868</arg>
              <arg attribute="fields">5,8,8,11</arg>
              <arg attribute="conditional">"k".equals("true") &amp;&amp; "m".equals("true")  &amp;&amp; "e".startsWith("2")   &amp;&amp; "h".equals("NULL") &amp;&amp; i&gt;0 &amp;&amp; j==0</arg>
          </parameters>
      </LNData>
      <!-- 
        El siguiente paquete valida si la cuenta es por pagar, de 
        tercero y esta es acreditada, y SI tiene relacion a documento 
        para cargar el valor del credito, si es asi entonces almacenara 
        información en la tabla cartera con un nuevo documento.
       -->
       
    <LNData>
          <driver>LNSelectedField</driver>
          <method>getSubpackage</method>
          <parameters>
              <arg attribute="sql">HCINS0019</arg>
              <arg attribute="fields">5,7,9,11</arg>
              <arg attribute="conditional">"k".equals("true") &amp;&amp; "m".equals("true") &amp;&amp; "e".startsWith("2") &amp;&amp; !"h".equals("NULL") &amp;&amp; i==0 &amp;&amp; j&gt;0</arg>
          </parameters>
      </LNData>
      
       <!-- 
        El siguiente paquete valida si la cuenta por pagar es debitada, la 
        cuenta contable es de tercero; entonces si es asi almacenara 
        información en la tabla cartera acreditando el documento recibido.
       -->
    <LNData>
          <driver>LNSelectedField</driver>
          <method>getSubpackage</method>
          <parameters>
              <arg attribute="sql">HCINS0018</arg>
              <arg attribute="fields">5,7,8,11</arg>
              <arg attribute="conditional">"k".equals("true") &amp;&amp; "m".equals("true") &amp;&amp; "e".startsWith("2") &amp;&amp; i&gt;0 &amp;&amp; j==0</arg>
          </parameters>
      </LNData>

    </subarg>
    <LNData>
      <driver>LNContabilidad</driver>
      <method>recoverDocument</method>
    </LNData>
    <arg attribute="removeKey">dcredito</arg>
    
    
    <!-- <arg>NFUPD0003</arg>   -->

</container>    