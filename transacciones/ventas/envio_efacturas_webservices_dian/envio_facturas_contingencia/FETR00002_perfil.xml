<FORM>
  <preferences>
    <size width="1200" height="640" />
    <name>Envio de Facturas Contingencia</name>
    <icon>/icons/network_clouds.png</icon>
    <iconificable />
    <resizable />
    <closable />

    <exportValue>keyBanco,140</exportValue>
    <loadMultiBranch>LCSEL0251</loadMultiBranch>
    <notCleanExportValue>trm</notCleanExportValue>
    <notCleanExportValue>id_bodega</notCleanExportValue>
    <notCleanExportValue>id_bodega_separado</notCleanExportValue>
    <notCleanExportValue>id_centrocosto</notCleanExportValue>
    <notCleanExportValue>codigo_tipo</notCleanExportValue>
    <notCleanExportValue>nombre_suc</notCleanExportValue>
    <notCleanExportValue>direccion</notCleanExportValue>
    <notCleanExportValue>telefono</notCleanExportValue>
    <notCleanExportValue>email</notCleanExportValue>
    <notCleanExportValue>ciudad</notCleanExportValue>
    <notCleanExportValue>catalogo</notCleanExportValue>
    <notCleanExportValue>keyBodega</notCleanExportValue>
    <notCleanExportValue>vendedor</notCleanExportValue>
    <notCleanExportValue>nitalterno</notCleanExportValue>
    <notCleanExportValue>terceroal</notCleanExportValue>
    <notCleanExportValue>regimenal</notCleanExportValue>
    <notCleanExportValue>codigotiposep</notCleanExportValue>

    <notCleanExportValue>horarioatencion</notCleanExportValue>
    <notCleanExportValue>piepaginauno</notCleanExportValue>
    <notCleanExportValue>piepaginados</notCleanExportValue>
    <notCleanExportValue>piepaginatres</notCleanExportValue>
    <notCleanExportValue>trm</notCleanExportValue>
    <notCleanExportValue>nitalterno</notCleanExportValue>

    <mainPackageStore>id_bodega</mainPackageStore>
    <minorPackageStore>id_bodega_separado</minorPackageStore>
    <costCenter>id_centrocosto</costCenter>
    <documentPrefix>codigo_tipo</documentPrefix>
    <branchName>nombre_suc</branchName>
    <branchAddress>direccion</branchAddress>
    <branchPhone>telefono</branchPhone>
    <branchEmail>email</branchEmail>
    <branchCity>ciudad</branchCity>    

    <requestFocus>client.gui.components.TableFindData</requestFocus>
    <!-- <consecutive>WS</consecutive> -->
  </preferences>
  <panel locate="North" type="BorderLayout">
    <panel locate="North" type="BorderLayout">
      <box locate="North" length="40" />
      <!--<box locate="South" length="40" />
      <box locate="West" width="50" />-->
      <panel locate="Center" type="BorderLayout">
          <panel locate="Center" type="GridLayout" rows="4" cols="1">
            <component locate="Center">
              <driver>common.gui.components.XMLLabel</driver>
              <parameters>
                <arg attribute="text">Ultimo Envio</arg>
                <arg attribute="font">Dialog,1,14</arg>
              </parameters>
            </component>
            <component locate="Center">
              <driver>common.gui.components.XMLLabel</driver>
              <parameters>
                <arg attribute="text">Numero de Documento</arg>
                <arg attribute="font">Dialog,1,14</arg>
              </parameters>
            </component>
            <component locate="Center">
              <driver>common.gui.components.XMLLabel</driver>
              <parameters>
                <arg attribute="text">Fecha de Transacción</arg>
                <arg attribute="font">Dialog,1,14</arg>
              </parameters>
            </component>
            <component locate="Center">
              <driver>common.gui.components.XMLLabel</driver>
              <parameters>
                <arg attribute="text">Total Registros a enviar</arg>
                <arg attribute="font">Dialog,1,14</arg>
              </parameters>
            </component>
          </panel>
          <box locate="South" length="15" />
          <box locate="West" width="720" />
          <panel locate="East" type="GridLayout" rows="4" cols="1">
                <component locate="Center">
                    <driver id="uws">common.gui.components.GenericData</driver>
                    <parameters>
                        <subarg>
                          <arg attribute="format">TEXT</arg>
                          <arg attribute="size">11</arg>
                          <arg attribute="maxlength">20</arg>
                          <arg attribute="enabled">false</arg>
                          <arg attribute="clean">false</arg>
                          <arg attribute="font">Dialog,1,16</arg>
                          <arg attribute="alignment">LEFT</arg>
                          <arg attribute="queryOnInit">true</arg>
                          <arg attribute="sqlInit">DESEL0021</arg>
                        </subarg>
                    </parameters>
                </component>
              <component>
                <driver id="nro_fact">client.gui.components.TableDataFields</driver>
                <parameters>
                    <subarg>
                        <arg attribute="format">TEXT</arg>
                        <arg attribute="size">10</arg>
                        <arg attribute="maxlength">26</arg>
                        <arg attribute="enabled">false</arg>
                        <arg attribute="clean">false</arg>
                        <arg attribute="font">Dialog,1,18</arg>
                        <arg attribute="foreground">249,87,87</arg>
                        <arg attribute="background">0,191,255</arg>
                        <arg attribute="alignment">RIGHT</arg>
                        <!-- <arg attribute="idDocument">WS</arg> -->
                        <arg attribute="idAutoDocument">codigo_tipo</arg>
                    </subarg>
                </parameters>
            </component>
            <component>
              <driver id="date">common.gui.components.XMLDateField</driver>
              <parameters>
                <arg attribute="dateFormatString">yyyy-MM-dd HH:mm:ss</arg>
                <arg attribute="exportValue">fechai</arg>
                <arg attribute="importValue">codigo_tipo</arg>
                <arg attribute="sqlCode">DESEL0017</arg>
                <arg attribute="sqlCode">DESEL0020</arg>
              </parameters>
            </component>
              <component>
                <driver id="total_records">client.gui.components.TableDataFields</driver>
                <parameters>
                    <subarg>
                        <arg attribute="format">NUMERIC</arg>
                        <arg attribute="size">10</arg>
                        <arg attribute="maxlength">26</arg>
                        <arg attribute="enabled">false</arg>
                        <arg attribute="clean">false</arg>
                        <arg attribute="calculateExportValue">totalreg</arg>
                        <arg attribute="font">Dialog,1,18</arg>
                        <arg attribute="foreground">249,87,87</arg>
                        <arg attribute="background">0,191,255</arg>
                        <arg attribute="alignment">RIGHT</arg>
                        <arg attribute="exportValue">totalpsend</arg>
                    </subarg>
                </parameters>
            </component>
        </panel>
      </panel>
    </panel>
    <box locate="East" width="100" />
    
  </panel>
  <tab>
    <panel name="Consolidado" icon="/icons/ico_confirmaciones_24x24.png" type="BorderLayout">
      <component locate="Center">
        <driver id="consolidado">client.gui.components.TableFindData</driver>
        <parameters>
          <arg attribute="rows">100</arg>
          <arg attribute="colorBackground">0,191,255</arg>
          <arg attribute="colorSelected">30,194,255</arg>
          <arg attribute="protectSelected">true</arg>
          <arg attribute="driverEvent" id="date">common.gui.components.XMLDateField</arg>
          <arg attribute="keySQL">DESEL0020</arg>
          <arg attribute="exportTotalCol">f,totalreg</arg>
          <arg attribute="exportTotalCol">g,totaldif</arg>
          <arg attribute="exportTotalCol">h,totalsend</arg>
          <arg attribute="exportTotalCol">i,next</arg>
          <arg attribute="totales">f,g,h,i</arg>
          <arg attribute="beanshell">i=b!=0 &amp;&amp; c!=0?(b+1-c):0</arg>
          <arg attribute="conditionalColor">153,255,153:f==h &amp;&amp; f!=0</arg>
          <arg attribute="conditionalColor">251,141,141:(b+1) != c &amp;&amp; c!=0</arg>
          <subarg><!-- a 0 -->
            <arg attribute="name">Documento</arg>
            <arg attribute="length">263</arg>
            <arg attribute="type">STRING</arg>
          </subarg>
          <subarg><!-- b 1 -->
            <arg attribute="name">Ultimo Doc WS</arg>
            <arg attribute="length">140</arg>
            <arg attribute="type">INTEGER</arg>
          </subarg>
          <subarg><!-- c 1 -->
            <arg attribute="name">Doc. Inicial</arg>
            <arg attribute="length">140</arg>
            <arg attribute="type">INTEGER</arg>
          </subarg>
          <subarg><!-- d 1 -->
            <arg attribute="name">Doc. Final</arg>
            <arg attribute="length">140</arg>
            <arg attribute="type">INTEGER</arg>
          </subarg>
          <subarg><!-- e 1 -->
            <arg attribute="name">T. Docs</arg>
            <arg attribute="length">120</arg>
            <arg attribute="type">INTEGER</arg>
          </subarg>
          <subarg><!-- f 6 -->
            <arg attribute="name">T. Reg</arg>
            <arg attribute="length">120</arg>
            <arg attribute="type">INTEGER</arg>
          </subarg>
          <subarg><!-- g 6 -->
            <arg attribute="name">Diferencia</arg>
            <arg attribute="length">120</arg>
            <arg attribute="type">INTEGER</arg>
          </subarg>
          <subarg><!-- H 8 -->
            <arg attribute="name">Enviados WS</arg>
            <arg attribute="length">120</arg>
            <arg attribute="type">INTEGER</arg>
          </subarg>
          <subarg><!-- i 8 -->
            <arg attribute="name">Consecutivo Envio</arg>
            <arg attribute="length">120</arg>
            <arg attribute="type">INTEGER</arg>
          </subarg>
          </parameters>

      </component>
      <panel locate="South" type="BorderLayout">
        <panel locate="North" type="GridLayout" rows="1" cols="5">
          <box locate="North" length="25" />
          <box locate="North" length="25" />
        </panel>
      </panel>
    </panel>
    <panel name="Contingencia" icon="/icons/ico_factura_credito_24x24.png" type="BorderLayout">
      <component locate="Center">
        <driver id="facturas">client.gui.components.TableFindData</driver>
        <parameters>
          <arg attribute="rows">100</arg>
          <arg attribute="colorBackground">0,191,255</arg>
          <arg attribute="colorSelected">30,194,255</arg>
          <arg attribute="protectSelected">true</arg>
          <arg attribute="driverEvent" id="date">common.gui.components.XMLDateField</arg>
          <arg attribute="keySQL">DESEL0017</arg>
          <arg attribute="conditionalColor">251,141,141:h!=0 &amp;&amp; h!=200</arg>
          <arg attribute="conditionalColor">153,255,153:h==0</arg>

          <subarg><!-- a 0 -->
            <arg attribute="name">Fecha</arg>
            <arg attribute="length">140</arg>
            <arg attribute="type">STRING</arg>
          </subarg>
          <subarg><!-- b 1 -->
            <arg attribute="name">Pref</arg>
            <arg attribute="length">50</arg>
            <arg attribute="type">STRING</arg>
          </subarg>
          <subarg><!-- c 2 -->
            <arg attribute="name">Numero</arg>
            <arg attribute="length">100</arg>
            <arg attribute="type">STRING</arg>
          </subarg>
          <subarg><!-- d 3 -->
            <arg attribute="name">Nit/CC</arg>
            <arg attribute="length">100</arg>
            <arg attribute="type">STRING</arg>
          </subarg>
          <subarg><!-- e 4 -->
            <arg attribute="name">Nombre</arg>
            <arg attribute="length">210</arg>
            <arg attribute="type">STRING</arg>
          </subarg>
          <subarg><!-- f 5 -->
            <arg attribute="name">CUFE</arg>
            <arg attribute="length">350</arg>
            <arg attribute="type">STRING</arg>
          </subarg>
          <subarg><!-- g 6 -->
            <arg attribute="name">Valor</arg>
            <arg attribute="length">109</arg>
            <arg attribute="type">DECIMAL</arg>
          </subarg>
          <subarg><!-- h 7 -->
            <arg attribute="name">Estado</arg>
            <arg attribute="length">0</arg>
            <arg attribute="type">INTEGER</arg>
          </subarg>
          </parameters>

      </component>
      <panel locate="South" type="BorderLayout">
        <panel locate="North" type="GridLayout" rows="1" cols="5">
          <box locate="North" length="25" />
          <box locate="North" length="25" />
        </panel>
      </panel>
    </panel>


  </tab>
  <component locate="South">
    <driver>common.gui.components.ButtonsPanel</driver>
    <parameters>
      <arg>SAVE</arg>
      <arg>NEW</arg>
      <arg>EXIT</arg>
    </parameters>
    <events>
      <object>
        <name>NEW</name>
        <!--  limpiando llaves externas -->
        <component>
          <driver>common.gui.components.ButtonsPanel</driver>
          <method>setEnabled</method>
          <parameters>
            <arg attribute="button">SAVE</arg>
            <arg attribute="state">true</arg>
          </parameters>
        </component>
        <component>
              <driver id="date">common.gui.components.XMLDateField</driver>
            <method>clean</method>
        </component>
        <component>
            <driver id="consolidado">client.gui.components.TableFindData</driver>
            <method>clean</method>
        </component>
        <component>
            <driver id="facturas">client.gui.components.TableFindData</driver>
            <method>clean</method>
        </component>
        <!--  limpiando llaves externas -->
        <component>
            <driver>this</driver>
            <method>cleanExternalValues</method>
        </component>

      </object>
      <object>
        <name>SAVE</name>
        <action>
          <type>transaction</type>
          <component>
            <driver>this</driver>
            <method>validMultiPackage</method>
            <parameters>
              <driver attribute="driver" id="date">common.gui.components.XMLDateField</driver>
              <arg attribute="errorMessage">Error, Falta ingresar la fecha</arg>
            </parameters>
          </component>
          <component>
            <driver id="total_records">client.gui.components.TableDataFields</driver>
            <method>validPackage</method>
            <parameters>
              <arg attribute="conditional">totalpsend!=0.0</arg>
              <arg attribute="errorMessage">Error: No existen registros a exportar en la fecha seleccionada</arg>
            </parameters>
          </component>
          <!-- <component>
            <driver id="total_records">client.gui.components.TableDataFields</driver>
            <method>validPackage</method>
            <parameters>
              <arg attribute="conditional">next==0.0</arg>
              <arg attribute="errorMessage">Error: El ultimo registro inicial a enviar de alguno de los documentos no es consecutivo con el ultimo enviado</arg>
            </parameters>
          </component> -->
          <component>
            <driver id="total_records">client.gui.components.TableDataFields</driver>
            <method>validPackage</method>
            <parameters>
              <arg attribute="conditional">totalpsend!=0.0</arg>
              <arg attribute="errorMessage">Error: No existen registros a exportar en la fecha seleccionada</arg>
            </parameters>
          </component>
          <component>
            <driver>common.gui.components.ButtonsPanel</driver>
            <method>setEnabled</method>
            <parameters>
              <arg attribute="button">SAVE</arg>
              <arg attribute="state">false</arg>
            </parameters>
          </component>
          
            <!-- NA -->
            <component>
              <driver>this</driver>
              <method>getPackage</method>
              <parameters>
                <subarg>
                  <arg attribute="importValue">codigo_tipo</arg>
                </subarg>
              </parameters>
            </component>

          <component>
              <driver id="date">common.gui.components.XMLDateField</driver>
              <method>getPackage</method>
        </component>

        </action>
      </object>
    </events>
  </component>
</FORM>
